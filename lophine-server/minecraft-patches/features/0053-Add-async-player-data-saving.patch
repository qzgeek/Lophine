+    // Lophine start - 异步写盘实现
+    private static void submitAsync(final Path dir, final UUID uuid, final CompoundTag tag) {
+        ASYNC_PENDING_DIRS.put(uuid, dir);
+        ASYNC_PENDING_TAGS.put(uuid, tag);
+        ASYNC_WRITER.submit(() -> drainAsync(uuid));
+    }
+
+    private static void drainAsync(final UUID uuid) {
+        synchronized (ASYNC_LOCKS.computeIfAbsent(uuid, k -> new Object())) {
+            final CompoundTag tag = ASYNC_PENDING_TAGS.remove(uuid);
+            if (tag == null) return; // 已被更早的任务写掉
+            final Path dir = ASYNC_PENDING_DIRS.get(uuid);
+            writeAsyncOne(dir, uuid, tag);
+        }
+    }
+
+    private static void writeAsyncOne(final Path dir, final UUID uuid, final CompoundTag tag) {
+        try {
+            final Path tmp = Files.createTempFile(dir, uuid + "-", ".dat");
+            // Lophine start - 优先 libdeflate gzip 压缩（C++ 加速），失败回退 Java GZIP
+            if (fun.bm.lophine.utils.LophineGzip.isAvailable()) {
+                final java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
+                try (java.io.DataOutputStream dos = new java.io.DataOutputStream(baos)) {
+                    NbtIo.write(tag, dos); // 序列化 NBT（未压缩）
+                }
+                final byte[] compressed = fun.bm.lophine.utils.LophineGzip.compress(baos.toByteArray());
+                if (compressed != null) {
+                    Files.write(tmp, compressed);
+                    final Path real = dir.resolve(uuid + ".dat");
+                    final Path old = dir.resolve(uuid + ".dat_old");
+                    Util.safeReplaceFile(real, tmp, old);
+                    return;
+                }
+            }
+            // Lophine end - libdeflate gzip 压缩
+            try (OutputStream out = Files.newOutputStream(tmp)) { // 无 SYNC，缓冲写
+                NbtIo.writeCompressed(tag, out);
+            }
+            final Path real = dir.resolve(uuid + ".dat");
+            final Path old = dir.resolve(uuid + ".dat_old");
+            Util.safeReplaceFile(real, tmp, old);
+        } catch (IOException e) {
+            LOGGER.error("Lophine async save player data failed: {}", uuid, e);
+        }
+    }
+
+    /** 服务器关闭前调用：停止接收新任务并等待所有 pending 写盘完成。 */
+    public static void shutdownAsync() {
+        ASYNC_WRITER.shutdown();
+        try {
+            if (!ASYNC_WRITER.awaitTermination(60, TimeUnit.SECONDS)) {
+                LOGGER.error("Lophine player data writer did not finish in 60s, forcing shutdown");
+                ASYNC_WRITER.shutdownNow();
+            }
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            ASYNC_WRITER.shutdownNow();
+        }
+    }
+    // Lophine end - 异步写盘实现
 
